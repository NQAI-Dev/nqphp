{
    "name": "nqai-dev/nqphp",
    "description": "nqphp \u2014 modular monolith PHP framework with Symfony components. Vertical Slice Architecture, auto-discovery via attributes, JS modules per controller. PHP 8.4+.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "symfony",
        "modular-monolith",
        "vertical-slice"
    ],
    "require": [
        "php",
        "symfony/routing",
        "symfony/http-kernel",
        "symfony/http-foundation",
        "symfony/console",
        "symfony/dependency-injection",
        "symfony/event-dispatcher",
        "symfony/yaml",
        "symfony/scheduler"
    ],
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Nqphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nqphp\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/console"
    ],
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs:fix": "php-cs-fixer fix --using-cache=no"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
