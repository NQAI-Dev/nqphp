#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Nqphp\Core\Console\CommandDiscoverer;
use Nqphp\Core\Kernel\Kernel;
use Symfony\Component\Console\Application;

/**
 * nqphp CLI entry point.
 *
 * Phase 2: routes the framework to a real Symfony Console Application.
 * Commands are discovered from `#[AsCommand]` attributes across:
 *   - src/Feature/*/Command/*.php   (project commands)
 *   - src/Core/Command/*.php        (framework commands, future)
 *
 * The legacy hand-rolled `routes:list` is preserved as a built-in
 * command so CI can still validate the route surface without registering
 * a feature command for it.
 */
final class RoutesListCommand extends \Symfony\Component\Console\Command\Command
{
    public function __construct(private readonly Kernel $kernel)
    {
        parent::__construct('routes:list', 'List all routes discovered from #[Controller]+#[Route] attributes.');
    }

    protected function execute(\Symfony\Component\Console\Input\InputInterface $input, \Symfony\Component\Console\Output\OutputInterface $output): int
    {
        $routes = $this->kernel->getRouteCollection();
        $rows = [];
        $maxName = 0;
        foreach ($routes->all() as $name => $route) {
            $maxName = max($maxName, \strlen($name));
            $rows[] = [$name, $route->getPath(), implode('|', $route->getMethods() ?: ['ANY'])];
        }
        \usort($rows, fn($a, $b) => $a[0] <=> $b[0]);

        $output->writeln('<info>Discovered routes</info>');
        if (\count($rows) === 0) {
            $output->writeln('  <comment>(no routes)</comment>');
            return self::SUCCESS;
        }
        $output->writeln(sprintf('  %-'.(int) $maxName.'s  %-30s  %s', 'NAME', 'PATH', 'METHODS'));
        foreach ($rows as [$n, $p, $m]) {
            $output->writeln(sprintf('  %-'.(int) $maxName.'s  %-30s  %s', $n, $p, $m));
        }
        return self::SUCCESS;
    }
}

final class ScheduleListCommand extends \Symfony\Component\Console\Command\Command
{
    public function __construct(private readonly \Nqphp\Core\Scheduler\ScheduleDiscoverer $discoverer)
    {
        parent::__construct('schedule:list', 'List all scheduled tasks discovered from #[Schedule] attributes.');
    }

    protected function execute(\Symfony\Component\Console\Input\InputInterface $input, \Symfony\Component\Console\Output\OutputInterface $output): int
    {
        $schedules = $this->discoverer->discover()->all();
        $output->writeln('<info>Discovered schedules</info>');
        if (\count($schedules) === 0) {
            $output->writeln('  <comment>(no schedules)</comment>');
            return self::SUCCESS;
        }
        $rows = [];
        $maxName = 0;
        foreach ($schedules as $s) {
            $maxName = max($maxName, \strlen($s['name']));
            $rows[] = [$s['name'], $s['cron'], $s['description']];
        }
        \usort($rows, fn($a, $b) => $a[0] <=> $b[0]);
        $output->writeln(sprintf('  %-'.(int) $maxName.'s  %-25s  %s', 'NAME', 'CRON', 'DESCRIPTION'));
        foreach ($rows as [$n, $c, $d]) {
            $output->writeln(sprintf('  %-'.(int) $maxName.'s  %-25s  %s', $n, $c, $d));
        }
        return self::SUCCESS;
    }
}

final class ScheduleRunCommand extends \Symfony\Component\Console\Command\Command
{
    public function __construct(private readonly \Nqphp\Core\Scheduler\ScheduleDiscoverer $discoverer)
    {
        parent::__construct('schedule:run', 'Run scheduled tasks whose cron is due right now.');
    }

    protected function configure(): void
    {
        $this->addArgument('name', \Symfony\Component\Console\Input\InputArgument::OPTIONAL, 'Run only this schedule by name.');
        $this->addOption('force', 'f', \Symfony\Component\Console\Input\InputOption::VALUE_NONE, 'Run all schedules regardless of cron (dry-run alternative).');
    }

    protected function execute(\Symfony\Component\Console\Input\InputInterface $input, \Symfony\Component\Console\Output\OutputInterface $output): int
    {
        $schedules = $this->discoverer->discover()->all();
        if (\count($schedules) === 0) {
            $output->writeln('<comment>(no schedules configured)</comment>');
            return self::SUCCESS;
        }

        $targetName = $input->getArgument('name');
        $force = (bool) $input->getOption('force');
        $ran = 0;
        $errors = 0;

        foreach ($schedules as $s) {
            if ($targetName !== null && $s['name'] !== $targetName) {
                continue;
            }
            if (!$force && !$this->isDue($s['cron'])) {
                continue;
            }
            $output->writeln(sprintf('  <info>running</info> %s — %s', $s['name'], $s['cron']));
            try {
                [$_cls, $method] = $s['callable'];
                $_cls::$method();
                $ran++;
            } catch (\Throwable $e) {
                $output->writeln(sprintf('    <error>FAIL</error>: %s', $e->getMessage()));
                $errors++;
            }
        }

        if ($ran === 0) {
            $output->writeln('<comment>(no schedules due — pass --force to run all)</comment>');
        } else {
            $output->writeln(sprintf('<info>ran %d schedule(s), %d error(s)</info>', $ran, $errors));
        }
        return $errors === 0 ? self::SUCCESS : self::FAILURE;
    }

    /**
     * Minimal cron-due check: returns true if the current minute
     * matches any minute in the 5-field cron expression. Real apps
     * should rely on symfony/scheduler's full RecurringMessage
     * evaluator (Phase 2 #5).
     *
     * Supports simple expressions: "*", "*/N", and a single integer
     * for each of (minute, hour, dom, month, dow). Anything more
     * complex returns true (conservative: "always due"). That's good
     * enough for the Phase 2 #4 discovery-side wiring — the real
     * cron parsing happens in schedule:run when it imports the
     * scheduled task into a symfony/scheduler Schedule object.
     */
    private function isDue(string $cron): bool
    {
        $parts = preg_split('/\s+/', trim($cron));
        if (\count($parts) !== 5) {
            return true;  // unknown form → assume due
        }
        [$min, $hour, $dom, $month, $dow] = $parts;
        $now = getdate();
        return $this->fieldMatches($min, $now['minutes'])
            && $this->fieldMatches($hour, $now['hours'])
            && $this->fieldMatches($dom, $now['mday'])
            && $this->fieldMatches($month, $now['mon'])
            && $this->fieldMatches($dow, $now['wday']);
    }

    private function fieldMatches(string $field, int $value): bool
    {
        if ($field === '*') {
            return true;
        }
        foreach (explode(',', $field) as $token) {
            if (str_starts_with($token, '*/')) {
                $step = (int) substr($token, 2);
                if ($step > 0 && $value % $step === 0) {
                    return true;
                }
                continue;
            }
            if ((int) $token === $value) {
                return true;
            }
        }
        return false;
    }
}

$projectDir = dirname(__DIR__);
$kernel = new Kernel($projectDir);

$cmdDiscoverer = new CommandDiscoverer([
    $projectDir . '/src/Feature',
    $projectDir . '/src/Core',
]);
$schedDiscoverer = new \Nqphp\Core\Scheduler\ScheduleDiscoverer([
    $projectDir . '/src/Feature',
    $projectDir . '/src/Core',
]);

$app = new Application('nqphp', '0.2.0-dev');
$app->add(new RoutesListCommand($kernel));
$app->add(new ScheduleListCommand($schedDiscoverer));
$app->add(new ScheduleRunCommand($schedDiscoverer));
foreach ($cmdDiscoverer->discover() as $command) {
    $app->add($command);
}
$app->setDefaultCommand('list', false);
$app->run();
